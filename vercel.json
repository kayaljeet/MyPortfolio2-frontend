{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/parking-ticket/app/:path*",
      "destination": "https://parking-ticket-frontend.vercel.app/parking-ticket/app/:path*"
    },
    {
      "source": "/parking-ticket/api/:path*",
